rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Profile photos: publicly viewable (used as avatars across the app),
    // but only the owning signed-in user can upload/replace their own.
    // Path written by src/services/profilePhotoService.ts
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Commissioning source documents: the deponent's uploaded original file,
    // kept so the final certified instrument can be built by overlaying
    // signatures onto the real document instead of a synthetic substitute.
    // Public read mirrors commissioningRequests' own "allow read: if true"
    // (needed to rebuild/verify the signed instrument); any signed-in user
    // may upload one, mirroring commissioningRequests' create/update rule.
    // Path written by src/services/documentStorageService.ts
    match /commissioningDocuments/{requestId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.resource.size < 25 * 1024 * 1024;
    }

    // Draft documents: a user's own in-progress upload, not yet submitted to
    // a Commissioner. Unlike a commissioning document, a draft is private —
    // only its owner (encoded in the path itself) may read or write it.
    // Path written by src/services/documentStorageService.ts
    match /draftDocuments/{uploaderId}/{draftId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uploaderId;
      allow write: if request.auth != null
                    && request.auth.uid == uploaderId
                    && request.resource.size < 25 * 1024 * 1024;
    }
  }
}

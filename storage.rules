rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Profile photos: publicly viewable (used as avatars across the app),
    // but only the owning signed-in user can upload/replace their own.
    // Path written by src/services/profilePhotoService.ts
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MTN Mobile Money Open API (Uganda MoMo API)
MTN_MOMO_API_KEY=""
MTN_MOMO_USER_ID=""
MTN_MOMO_PRIMARY_KEY=""
MTN_MOMO_TARGET_ENV="sandbox"

# Airtel Money OpenAPI (Uganda Airtel Payments)
AIRTEL_MONEY_CLIENT_ID=""
AIRTEL_MONEY_CLIENT_SECRET=""
AIRTEL_MONEY_PIN=""
AIRTEL_MONEY_ENV="staging"

# ioTec Pay API Integration (Mobile Money & Card Payments: https://iotec.io/api-docs/pay)
IOTEC_CLIENT_ID=""
IOTEC_CLIENT_SECRET=""
IOTEC_WALLET_ID=""
IOTEC_WALLET_NAME=""
IOTEC_AUTH_URL="https://id.iotec.io/connect/token"
IOTEC_BASE_URL="https://pay.iotec.io"
IOTEC_ENV="sandbox"
IOTEC_WEBHOOK_SECRET=""

# Daily.co WebRTC Video API Configuration
# Room creation runs server-side (server.ts) so this key is never sent to
# the browser. Get it from https://dashboard.daily.co under Developers > API keys.
DAILY_CO_API_KEY=""
DAILY_CO_DOMAIN="https://wallahi.daily.co"
DAILY_CO_ROOM_PREFIX="wallahi-"

# Algolia Marketplace Search (optional — "Search Commissioner by name")
# Get these from https://dashboard.algolia.com under Settings > API Keys.
# ALGOLIA_ADMIN_API_KEY is the full-access/indexing key — server-side only,
# never sent to the browser (see api/_lib/algoliaSync.ts). Create it a
# "search" scoped API key (search-only, cannot write/delete) for
# ALGOLIA_SEARCH_API_KEY — that one IS sent to the browser to run queries.
# Until these are set, the Marketplace silently keeps using its existing
# client-side name filter instead — nothing breaks either way.
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_API_KEY=""
ALGOLIA_SEARCH_API_KEY=""
ALGOLIA_INDEX_NAME="walayi_commissioners_prod"


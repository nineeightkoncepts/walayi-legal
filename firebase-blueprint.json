{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing legal credentials, judicial details, and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "maxLength": 50 },
        "avatarUrl": { "type": "string", "maxLength": 1000 },
        "nationalIdNumber": { "type": "string", "maxLength": 100 },
        "stationCity": { "type": "string", "maxLength": 100 },
        "lawFirmName": { "type": "string", "maxLength": 200 },
        "isProSubscriber": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "completedCeremoniesCount": { "type": "number" },
        "indicativeFeeUGX": { "type": "number" },
        "availableNow": { "type": "boolean" },
        "allowsRemote": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "fullName", "email", "role"]
    },
    "CommissioningRequest": {
      "title": "CommissioningRequest",
      "description": "Legal commissioning request document, oath status, and audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "certificateNumber": { "type": "string", "maxLength": 100 },
        "documentTitle": { "type": "string", "maxLength": 300 },
        "documentType": { "type": "string", "maxLength": 100 },
        "deponentName": { "type": "string", "maxLength": 200 },
        "deponentNin": { "type": "string", "maxLength": 100 },
        "deponentPhone": { "type": "string", "maxLength": 50 },
        "deponentEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "deponentUserId": { "type": "string", "maxLength": 128 },
        "assignedProfessionalId": { "type": "string", "maxLength": 128 },
        "assignedProfessionalName": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "maxLength": 50 },
        "documentSha256": { "type": "string", "maxLength": 128 },
        "finalDocumentSha256": { "type": "string", "maxLength": 128 },
        "solemnisationType": { "type": "string", "maxLength": 100 },
        "statutoryWordingUsed": { "type": "string", "maxLength": 2000 },
        "totalAmountUGX": { "type": "number" },
        "paymentStatus": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "completedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "certificateNumber", "documentTitle", "deponentUserId", "status"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "MTN MoMo, Airtel Money, Card, or ioTec commissioning payment transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "transactionRef": { "type": "string", "maxLength": 128 },
        "commissioningId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 200 },
        "provider": { "type": "string", "maxLength": 50 },
        "paymentChannel": { "type": "string", "maxLength": 50 },
        "phoneNumber": { "type": "string", "maxLength": 50 },
        "cardLast4": { "type": "string", "maxLength": 10 },
        "cardBrand": { "type": "string", "maxLength": 50 },
        "gateway": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "maxLength": 50 },
        "amountUGX": { "type": "number" },
        "platformFeeUGX": { "type": "number" },
        "netPayoutUGX": { "type": "number" },
        "status": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string", "maxLength": 100 },
        "externalProviderTxnId": { "type": "string", "maxLength": 128 },
        "iotecReference": { "type": "string", "maxLength": 128 },
        "failureReason": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "transactionRef", "userId", "amountUGX", "status"]
    },
    "AdminAuditEvent": {
      "title": "AdminAuditEvent",
      "description": "System and administrative compliance audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 200 },
        "adminName": { "type": "string", "maxLength": 200 },
        "action": { "type": "string", "maxLength": 200 },
        "targetType": { "type": "string", "maxLength": 50 },
        "targetId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with legal authority status"
    },
    "/commissioningRequests/{requestId}": {
      "schema": "CommissioningRequest",
      "description": "Statutory commissioning sessions and affidavits"
    },
    "/transactions/{txnId}": {
      "schema": "PaymentTransaction",
      "description": "MTN MoMo and escrow ledger records"
    },
    "/auditEvents/{eventId}": {
      "schema": "AdminAuditEvent",
      "description": "Immutable compliance and administrative audit logs"
    }
  }
}

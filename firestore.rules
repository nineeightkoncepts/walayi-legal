rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ambrosenen@gmail.com' ||
        request.auth.token.email == 'admin@wallahi.ug' ||
        request.auth.token.email == 'nineeightkoncepts@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin-tier roles a self-signup or self-edit may never grant itself —
    // only an existing admin (isAdmin()) may set these.
    function isPrivilegedRole(role) {
      return role == 'admin' || role == 'master_admin' || role == 'super_admin';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      // A user may self-register their own profile, but never with an
      // admin-tier role — that must be granted by an existing admin.
      allow create: if isAdmin() || (isOwner(userId) && !isPrivilegedRole(request.resource.data.role));
      // A user may edit their own profile (name, phone, signature, fee,
      // availability, etc.) but may never change their OWN role — that is
      // an admin-only action, enforced here by requiring it stay identical
      // unless the writer is already an admin.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();
    }

    // Commissioning Requests Collection (public read for verification portal)
    match /commissioningRequests/{requestId} {
      allow read: if true;
      // A request may only be created against a commissioner who is
      // actually ADMITTED — this is the real enforcement point for
      // "only an admitted professional can receive commissioning
      // requests" (see the users collection's admissionStatus field).
      // Checked server-side so a client bypassing the marketplace UI
      // (e.g. crafting the write directly) still can't target a
      // PENDING/REJECTED/SUSPENDED/EXPIRED commissioner.
      allow create: if isSignedIn() && (
        !('assignedProfessionalId' in request.resource.data) ||
        request.resource.data.assignedProfessionalId == null ||
        get(/databases/$(database)/documents/users/$(request.resource.data.assignedProfessionalId)).data.admissionStatus == 'ADMITTED'
      );
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Transactions Ledger
    match /transactions/{txnId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Audit Events Log (public read for independent audit verification)
    match /auditEvents/{eventId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // In-App Notifications
    // A notification is delivered to a specific user (userId) by a DIFFERENT
    // actor (e.g. an admin admitting a commissioner, or the system logging a
    // ceremony event) — so create is any signed-in user, mirroring
    // commissioningRequests' posture, but read/update/delete are restricted
    // to the notification's own owner (or an admin), so nobody can read or
    // tamper with another user's notification feed.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId is string;
      // Only marking read/unread (or an admin) is permitted — the owner may
      // not rewrite title/message/type after the fact.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.title == resource.data.title &&
          request.resource.data.message == resource.data.message &&
          request.resource.data.type == resource.data.type
        )
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Document Drafts — a user's own in-progress upload, saved so they can
    // leave WALAYI and resume later without losing the document or their
    // place in the wizard. Strictly private to the uploader (or an admin
    // for support purposes); never readable by any other party, unlike a
    // commissioningRequest which is public once it exists.
    match /documentDrafts/{draftId} {
      allow read, update, delete: if isSignedIn() && (resource.data.uploaderId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uploaderId == request.auth.uid;
    }

    // Commissioner Payout Destinations — deliberately kept out of the users
    // collection (which any signed-in user may read) so mobile-money payout
    // details are never exposed to anyone but their owner or an admin. The
    // document id is the commissioner's own uid.
    match /payoutDestinations/{commissionerId} {
      allow read, write: if isOwner(commissionerId) || isAdmin();
    }

    // Commissioner Fee Settings — same posture as payout destinations:
    // owner (or admin) only. Not currently marked private in these rules,
    // closing that gap alongside the payout destination migration.
    match /commissionerFeeSettings/{commissionerId} {
      allow read: if true;
      allow write: if isOwner(commissionerId) || isAdmin();
    }

    // WebRTC Signaling — the built-in (non-Daily.co) video chamber's peer
    // connection setup. Exchanged data is only session-description/ICE
    // candidate info scoped to one commissioning session, not sensitive
    // profile data, so this mirrors commissioningRequests' open posture
    // (any signed-in user; the session id itself is the effective secret).
    match /webrtcSessions/{sessionId} {
      allow read, write: if isSignedIn();
      match /offerCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
      match /answerCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }

    // Pending Account Invites — an admin-added user who hasn't clicked their
    // emailed activation link yet, so no Firebase Auth user (or users/{uid}
    // doc) exists for them yet. Only an admin may create/update these; the
    // invitee reads/deletes their own (by the signed-in email matching the
    // invite, once they've completed the passwordless sign-in link) to pull
    // their intended profile and clean up after applying it.
    match /pendingInvites/{inviteId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
    }
  }
}

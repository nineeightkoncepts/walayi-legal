rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ambrosenen@gmail.com' ||
        request.auth.token.email == 'admin@wallahi.ug' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin-tier roles a self-signup or self-edit may never grant itself —
    // only an existing admin (isAdmin()) may set these.
    function isPrivilegedRole(role) {
      return role == 'admin' || role == 'master_admin' || role == 'super_admin';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      // A user may self-register their own profile, but never with an
      // admin-tier role — that must be granted by an existing admin.
      allow create: if isAdmin() || (isOwner(userId) && !isPrivilegedRole(request.resource.data.role));
      // A user may edit their own profile (name, phone, signature, fee,
      // availability, etc.) but may never change their OWN role — that is
      // an admin-only action, enforced here by requiring it stay identical
      // unless the writer is already an admin.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();
    }

    // Commissioning Requests Collection (public read for verification portal)
    match /commissioningRequests/{requestId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Transactions Ledger
    match /transactions/{txnId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Audit Events Log (public read for independent audit verification)
    match /auditEvents/{eventId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
